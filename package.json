{
  "name": "mark-personal-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "i18next": "^26.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.1.9",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.6.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:ui": "vitest --ui --project=unit",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'e2e/**/*.ts' 'storybook-tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'e2e/**/*.ts' 'storybook-tests/**/*.ts' --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook": "python3 -m http.server 6006 --directory storybook-static",
    "test-storybook": "VITEST_STORYBOOK=false vitest --project=accessibility-tests",
    "test:storybook-visual": "playwright test --config=playwright-storybook.config.ts",
    "test:storybook-visual:update": "playwright test --config=playwright-storybook.config.ts --update-snapshots",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-vitest": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.4",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.4",
    "storybook-addon-pseudo-states": "^10.6.4",
    "typescript": "^7.0.0",
    "vite": "^8.3.5",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
